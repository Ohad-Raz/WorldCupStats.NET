<Window x:Class="WorldCupStats.WPF.MainWindow"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldCupStats.WPF"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStartupLocation="CenterScreen"
        Height="750" Width="1000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Top row -->
        <ComboBox x:Name="cmbFavoriteTeam"
              SelectionChanged="cmbFavoriteTeam_SelectionChanged"
              DisplayMemberPath="DisplayName"
              Grid.Row="0"
              Grid.Column="0"
              Margin="0,0,10,0"
              Height="30"/>

        <ComboBox x:Name="cmbOpponentTeam"
              SelectionChanged="cmbOpponentTeam_SelectionChanged"
              DisplayMemberPath="DisplayName"
              Grid.Row="0"
              Grid.Column="1"
              Margin="0,0,10,0"
              Height="30"/>

        <Button x:Name="btnSettings"
            Grid.Row="0"
            Grid.Column="2"
            Content="Settings"
            Width="100"
            Height="30"
            Click="btnSettings_Click"/>

        <!-- Result row -->
        <TextBlock x:Name="lblMatchResult"
               Grid.Row="1"
               Grid.Column="0"
               Grid.ColumnSpan="3"
               Margin="0,20,0,20"
               FontSize="24"
               FontWeight="Bold"
               Text="Select opponent to show result"/>

        <!-- Bottom area: buttons + pitch -->
        <Grid Grid.Row="2"
          Grid.Column="0"
          Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Buttons row -->
            <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
                <Button x:Name="btnFavoriteTeamDetails"
                    Content="Favorite team details"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="btnFavoriteTeamDetails_Click"/>

                <Button x:Name="btnOpponentTeamDetails"
                    Content="Opponent details"
                    Width="160"
                    Height="35"
                    Click="btnOpponentTeamDetails_Click"/>
            </StackPanel>

            <!-- Pitch row -->
            <Border Grid.Row="1"
        Background="ForestGreen"
        BorderBrush="White"
        BorderThickness="3"
        CornerRadius="4"
        ClipToBounds="True"
        MinHeight="300">

                <Grid>
                    <Grid IsHitTestVisible="False">

                        <Border Width="3"
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"/>

                        <!-- Center circle -->
                        <Ellipse Width="130"
                     Height="130"
                     Stroke="White"
                     StrokeThickness="3"
                     Fill="Transparent"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

                        <!-- Center point -->
                        <Ellipse Width="8"
                     Height="8"
                     Fill="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

                        <!-- Left penalty area -->
                        <Border Width="120"
                    Height="230"
                    BorderBrush="White"
                    BorderThickness="0,3,3,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>

                        <!-- Right penalty area -->
                        <Border Width="120"
                    Height="230"
                    BorderBrush="White"
                    BorderThickness="3,3,0,3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>

                        <!-- Left goal area -->
                        <Border Width="55"
                    Height="110"
                    BorderBrush="White"
                    BorderThickness="0,3,3,3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>

                        <!-- Right goal area -->
                        <Border Width="55"
                    Height="110"
                    BorderBrush="White"
                    BorderThickness="3,3,0,3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Dynamic player controls are drawn only on this Canvas -->
                    <Canvas x:Name="pitchCanvas"
        Background="Transparent"
        SizeChanged="pitchCanvas_SizeChanged"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Loading overlay -->
        <Grid x:Name="loadingOverlay"
      Grid.Row="0"
      Grid.RowSpan="3"
      Grid.Column="0"
      Grid.ColumnSpan="3"
      Background="#80000000"
      Visibility="Collapsed"
      Panel.ZIndex="100">

            <Border Width="240"
            Height="110"
            Background="White"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="20">

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Loading..."
                       FontSize="18"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

                    <ProgressBar Height="18"
                         IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
