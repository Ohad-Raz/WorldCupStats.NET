<Window x:Class="WorldCupStats.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldCupStats.WPF"
        mc:Ignorable="d"
        Title="Settings"
        Height="300"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Championship:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,12"/>

        <ComboBox x:Name="cmbChampionship"
                  Grid.Row="0"
                  Grid.Column="1"
                  Height="28"
                  Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Data source:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,12"/>

        <ComboBox x:Name="cmbDataSource"
                  Grid.Row="1"
                  Grid.Column="1"
                  Height="28"
                  Margin="0,0,0,12"/>
        <TextBlock Grid.Row="2"
           Grid.Column="0"
           Text="Window mode:"
           VerticalAlignment="Center"
           Margin="0,0,10,12"/>

        <ComboBox x:Name="cmbWindowMode"
          Grid.Row="2"
          Grid.Column="1"
          Height="28"
          Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3"
           Grid.Column="0"
           Text="Resolution:"
           VerticalAlignment="Center"
           Margin="0,0,10,12"/>

        <ComboBox x:Name="cmbResolution"
          Grid.Row="3"
          Grid.Column="1"
          Height="28"
          Margin="0,0,0,12"/>
        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            
<Button x:Name="btnConfirm"
        Content="Confirm"
        Width="90"
        Height="30"
        Margin="0,0,10,0"
        IsDefault="True"
        Click="btnConfirm_Click"/>

            <Button x:Name="btnCancel"
        Content="Cancel"
        Width="90"
        Height="30"
        IsCancel="True"
        Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>