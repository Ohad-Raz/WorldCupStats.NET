<Window x:Class="WorldCupStats.WPF.PlayerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldCupStats.WPF"
        mc:Ignorable="d"
       Title="Player Details"
        Height="360"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Opacity="1"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="120"
                Height="150"
                BorderBrush="Gray"
                BorderThickness="1"
                VerticalAlignment="Top">
            <Image x:Name="imgPlayer"
                   Stretch="UniformToFill"/>
        </Border>

        <Grid Grid.Column="1"
              Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblPlayerName"
                       Grid.Row="0"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,18"/>

            <TextBlock x:Name="lblShirtNumber"
                       Grid.Row="1"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="lblPosition"
                       Grid.Row="2"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="lblCaptain"
                       Grid.Row="3"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="lblGoals"
                       Grid.Row="4"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="lblYellowCards"
                       Grid.Row="5"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <Button Grid.Row="6"
                    Content="Close"
                    Width="90"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,0"
                    Click="btnClose_Click"/>
        </Grid>
    </Grid>
</Window>
